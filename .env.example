# MindCere runs as a static/offline companion by default because the hosted API
# and MongoDB free cluster may be paused or unavailable.
NEXT_PUBLIC_ENABLE_LIVE_API=false

# Only set this when the backend is funded/running again. Accepts either a host
# such as api.example.com or a full URL such as https://api.example.com.
NEXT_PUBLIC_API_URL=
